{
  "name": "robot-dog-interaction",
  "version": "1.0.0",
  "description": "机器狗交互管理系统后端服务",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migration:create": "node scripts/node-pg-migrate.cjs create",
    "migration:up": "node scripts/node-pg-migrate.cjs up",
    "migration:down": "node scripts/node-pg-migrate.cjs down",
    "migration:redo": "node scripts/node-pg-migrate.cjs redo",
    "test": "jest --runInBand",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "robot-dog",
    "interaction",
    "websocket",
    "ai"
  ],
  "author": "",
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.4",
    "multer": "^1.4.5-lts.2",
    "opusscript": "^0.1.0",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "wavesurfer.js": "^7.12.1",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^18.19.31",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "node-pg-migrate": "^8.0.4",
    "npm-check-updates": "^19.3.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
